{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portapapeles-universal-p2p/schema/sync-message.schema.json",
  "title": "ControlMessage",
  "description": "Mensajes de control del protocolo v2 (JSON en UTF-8, tramas 0x01/0x03), que viajan cifrados tras el handshake Noise IK. Los datos de archivo (trama 0x02) son binarios y no se describen aquí. Las cargas del handshake están en $defs (client_hello, server_hello). Cualquier cambio debe respetarse por igual en el móvil (TypeScript) y en el PC (Rust).",
  "oneOf": [
    { "$ref": "#/$defs/clip" },
    { "$ref": "#/$defs/file_start" },
    { "$ref": "#/$defs/file_ack" },
    { "$ref": "#/$defs/file_end" },
    { "$ref": "#/$defs/file_result" },
    { "$ref": "#/$defs/file_cancel" },
    { "$ref": "#/$defs/ping" },
    { "$ref": "#/$defs/pong" }
  ],
  "$defs": {
    "transferId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "Identificador de transferencia: 16 bytes en hex minúscula (en las tramas 0x02 viaja como 16 bytes crudos)."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 en hex minúscula."
    },
    "client_hello": {
      "description": "Carga JSON del mensaje 1 del handshake Noise IK (móvil → PC). No es un mensaje de control: viaja dentro del handshake, sin byte de tipo. Sustituye al `hello` en claro de la fase 1.",
      "type": "object",
      "required": ["v", "deviceId", "deviceName"],
      "properties": {
        "v": { "const": 2 },
        "deviceId": { "type": "string", "description": "Máximo 128 bytes en UTF-8." },
        "deviceName": { "type": "string", "description": "El PC lo recorta a 64 caracteres." },
        "willSendClip": { "type": "boolean" },
        "pairingToken": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$",
          "description": "Token del QR: 128 bits en base64url sin relleno. Solo al emparejar."
        }
      }
    },
    "server_hello": {
      "description": "Carga JSON del mensaje 2 del handshake Noise IK (PC → móvil): aceptación o rechazo. No es un mensaje de control.",
      "oneOf": [
        {
          "type": "object",
          "required": ["v", "accepted", "deviceId", "pcName"],
          "properties": {
            "v": { "const": 2 },
            "accepted": { "const": true },
            "deviceId": { "type": "string" },
            "pcName": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["v", "accepted", "reason"],
          "properties": {
            "v": { "const": 2 },
            "accepted": { "const": false },
            "reason": { "enum": ["not_paired", "pairing_expired"] }
          }
        }
      ]
    },
    "clip": {
      "type": "object",
      "required": ["kind", "id", "text", "hash"],
      "properties": {
        "kind": { "const": "clip" },
        "id": { "type": "string" },
        "text": { "type": "string", "description": "Texto copiado, máximo 1 MiB (1 048 576 bytes) en UTF-8." },
        "hash": { "$ref": "#/$defs/sha256", "description": "SHA-256 de `text` codificado en UTF-8." }
      }
    },
    "file_start": {
      "type": "object",
      "required": ["kind", "transferId", "name", "size", "mime"],
      "properties": {
        "kind": { "const": "file_start" },
        "transferId": { "$ref": "#/$defs/transferId" },
        "name": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "mime": { "type": "string" },
        "purpose": {
          "type": "string",
          "description": "Opcional. Ausente o desconocido: archivo normal (el receptor ignora un valor que no conozca). \"clipboard\": imagen para el portapapeles; `mime` debe ser image/png, image/jpeg o image/webp (si no, protocol_error) y `size` no puede pasar de 20 MiB (20 971 520 bytes; si pasa, el receptor responde file_cancel con reason \"too_large\")."
        }
      }
    },
    "file_ack": {
      "type": "object",
      "required": ["kind", "transferId", "received"],
      "properties": {
        "kind": { "const": "file_ack" },
        "transferId": { "$ref": "#/$defs/transferId" },
        "received": { "type": "integer", "minimum": 0, "description": "Bytes recibidos hasta ahora." }
      }
    },
    "file_end": {
      "type": "object",
      "required": ["kind", "transferId", "sha256"],
      "properties": {
        "kind": { "const": "file_end" },
        "transferId": { "$ref": "#/$defs/transferId" },
        "sha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 del archivo completo." }
      }
    },
    "file_result": {
      "type": "object",
      "required": ["kind", "transferId", "ok"],
      "properties": {
        "kind": { "const": "file_result" },
        "transferId": { "$ref": "#/$defs/transferId" },
        "ok": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "file_cancel": {
      "type": "object",
      "required": ["kind", "transferId", "reason"],
      "properties": {
        "kind": { "const": "file_cancel" },
        "transferId": { "$ref": "#/$defs/transferId" },
        "reason": { "type": "string" }
      }
    },
    "ping": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "ping" } }
    },
    "pong": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "pong" } }
    }
  }
}
