{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portapapeles-universal-p2p/schema/sync-message.schema.json",
  "title": "ControlMessage",
  "description": "Mensajes de control del protocolo v2 (JSON en UTF-8, tramas 0x01/0x03). Los datos de archivo (trama 0x02) son binarios y no se describen aquí. Cualquier cambio debe respetarse por igual en el móvil (TypeScript) y en el PC (Rust).",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/clip" },
    { "$ref": "#/$defs/file_start" },
    { "$ref": "#/$defs/file_ack" },
    { "$ref": "#/$defs/file_end" },
    { "$ref": "#/$defs/file_result" },
    { "$ref": "#/$defs/file_cancel" },
    { "$ref": "#/$defs/ping" },
    { "$ref": "#/$defs/pong" }
  ],
  "$defs": {
    "transferId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "Identificador de transferencia: 16 bytes en hex minúscula (en las tramas 0x02 viaja como 16 bytes crudos)."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 en hex minúscula."
    },
    "hello": {
      "type": "object",
      "required": ["kind", "v", "deviceId", "deviceName"],
      "properties": {
        "kind": { "const": "hello" },
        "v": { "const": 2 },
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "willSendClip": { "type": "boolean" }
      }
    },
    "clip": {
      "type": "object",
      "required": ["kind", "id", "text", "hash"],
      "properties": {
        "kind": { "const": "clip" },
        "id": { "type": "string" },
        "text": { "type": "string", "description": "Texto copiado, máximo 1 MiB (1 048 576 bytes) en UTF-8." },
        "hash": { "$ref": "#/$defs/sha256", "description": "SHA-256 de `text` codificado en UTF-8." }
      }
    },
    "file_start": {
      "type": "object",
      "required": ["kind", "transferId", "name", "size", "mime"],
      "properties": {
        "kind": { "const": "file_start" },
        "transferId": { "$ref": "#/$defs/transferId" },
        "name": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "mime": { "type": "string" }
      }
    },
    "file_ack": {
      "type": "object",
      "required": ["kind", "transferId", "received"],
      "properties": {
        "kind": { "const": "file_ack" },
        "transferId": { "$ref": "#/$defs/transferId" },
        "received": { "type": "integer", "minimum": 0, "description": "Bytes recibidos hasta ahora." }
      }
    },
    "file_end": {
      "type": "object",
      "required": ["kind", "transferId", "sha256"],
      "properties": {
        "kind": { "const": "file_end" },
        "transferId": { "$ref": "#/$defs/transferId" },
        "sha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 del archivo completo." }
      }
    },
    "file_result": {
      "type": "object",
      "required": ["kind", "transferId", "ok"],
      "properties": {
        "kind": { "const": "file_result" },
        "transferId": { "$ref": "#/$defs/transferId" },
        "ok": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "file_cancel": {
      "type": "object",
      "required": ["kind", "transferId", "reason"],
      "properties": {
        "kind": { "const": "file_cancel" },
        "transferId": { "$ref": "#/$defs/transferId" },
        "reason": { "type": "string" }
      }
    },
    "ping": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "ping" } }
    },
    "pong": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "pong" } }
    }
  }
}
